            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.staging.layer1.com/digital/v1/addresses",
            "params": [
              {
                "name": "assetPoolId",
                "value": "",
                "type": "query"
              },
              {
                "name": "q",
                "value": "",
                "type": "query",
                "description": "Query in lucene format. Supported fields: reference, customerId"
              },
              {
                "name": "pageNumber",
                "value": "",
                "type": "query"
              },
              {
                "name": "pageSize",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://auth.sandbox.layer1.com/auth/realms/bvnk/protocol/openid-connect/token",
