{
  "opencollection": "1.0.0",
  "info": {
    "name": "Digital Asset Transaction API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Transaction",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Claim blockchain transaction",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.staging.layer1.com/digital/v1/transaction-claims",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://auth.sandbox.layer1.com/auth/realms/bvnk/protocol/openid-connect/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Claim an existing blockchain transaction"
        },
        {
          "info": {
            "name": "List transactions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.staging.layer1.com/digital/v1/transactions",
            "params": [
              {
                "name": "q",
                "value": "",
                "type": "query",
                "description": "Query in lucene like format, e.g. hash:0x012a1. Supported properties: hash, reference, customerId, from, to. If time bounds are not provided default are applied"
              },
              {
                "name": "assetPoolId",
                "value": "",
                "type": "query",
                "description": "asset pool id"
              },
              {
                "name": "pageNumber",
                "value": "",
                "type": "query",
                "description": "current page number"
              },
              {
                "name": "pageSize",
                "value": "",
                "type": "query",
                "description": "number of items in a page"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://auth.sandbox.layer1.com/auth/realms/bvnk/protocol/openid-connect/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Retrieve paginated list of transactions"
        },
        {
          "info": {
            "name": "Get transaction",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.staging.layer1.com/digital/v1/transactions/:transactionId",
            "params": [
              {
                "name": "transactionId",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://auth.sandbox.layer1.com/auth/realms/bvnk/protocol/openid-connect/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Get transaction by id"
        }
      ]
    }
  ],
  "bundled": true
}