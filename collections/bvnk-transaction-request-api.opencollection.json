{
  "opencollection": "1.0.0",
  "info": {
    "name": "Digital Asset Transaction Request API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Transaction Request",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List transaction requests",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.staging.layer1.com/digital/v1/transaction-requests",
            "params": [
              {
                "name": "q",
                "value": "",
                "type": "query",
                "description": "Query in lucene like format, e.g. reference:REF-12a1. Supported properties: reference, type"
              },
              {
                "name": "assetPoolId",
                "value": "",
                "type": "query",
                "description": "asset pool id"
              },
              {
                "name": "pageNumber",
                "value": "",
                "type": "query",
                "description": "current page number"
              },
              {
                "name": "pageSize",
                "value": "",
                "type": "query",
                "description": "number of items in a page"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://auth.sandbox.layer1.com/auth/realms/bvnk/protocol/openid-connect/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Retrieve paginated list of transaction requests"
        },
        {
          "info": {
            "name": "Create transaction request",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.staging.layer1.com/digital/v1/transaction-requests",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://auth.sandbox.layer1.com/auth/realms/bvnk/protocol/openid-connect/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Create a new blockchain transaction"
        },
        {
          "info": {
            "name": "Create staking transaction request",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.staging.layer1.com/digital/v1/staking-requests",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://auth.sandbox.layer1.com/auth/realms/bvnk/protocol/openid-connect/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Create a new blockchain staking transaction"
        },
        {
          "info": {
            "name": "Get transaction request",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.staging.layer1.com/digital/v1/transaction-requests/:requestId",
            "params": [
              {
                "name": "requestId",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://auth.sandbox.layer1.com/auth/realms/bvnk/protocol/openid-connect/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Get transaction request by id"
        }
      ]
    }
  ],
  "bundled": true
}