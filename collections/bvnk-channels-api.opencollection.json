{
  "opencollection": "1.0.0",
  "info": {
    "name": "BVNK API Endpoints Channels API",
    "version": "1.0.1"
  },
  "items": [
    {
      "info": {
        "name": "Channels",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Channels",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.sandbox.bvnk.com/api/v2/channel",
            "params": [
              {
                "name": "merchantId",
                "value": "",
                "type": "query",
                "description": "The merchant ID that the channels belong to"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "Offset"
              },
              {
                "name": "max",
                "value": "",
                "type": "query",
                "description": "Maximum number of items in response"
              },
              {
                "name": "sort",
                "value": "",
                "type": "query",
                "description": "The attribute used to sort the data"
              },
              {
                "name": "order",
                "value": "",
                "type": "query",
                "description": "Ordering direction"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Retrieves all channels related to a Merchant ID."
        },
        {
          "info": {
            "name": "Create Channel",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.sandbox.bvnk.com/api/v2/channel",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Creates a channel that your end users can openly send payments to."
        },
        {
          "info": {
            "name": "Get Channel",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.sandbox.bvnk.com/api/v2/channel/:uuid",
            "params": [
              {
                "name": "uuid",
                "value": "",
                "type": "path",
                "description": "The UUID of the channel you are querying"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Retrieves a specific channel by UUID."
        },
        {
          "info": {
            "name": "Get Channel Payment",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.sandbox.bvnk.com/api/v2/channel/payment/:uuid",
            "params": [
              {
                "name": "uuid",
                "value": "",
                "type": "path",
                "description": "The UUID of the payment you are querying."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Retrieves a specific payment made into a channel."
        },
        {
          "info": {
            "name": "List Channel Payments",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.sandbox.bvnk.com/api/v2/channel/payment",
            "params": [
              {
                "name": "merchantId",
                "value": "",
                "type": "query",
                "description": "The Merchant ID"
              },
              {
                "name": "status",
                "value": "",
                "type": "query"
              },
              {
                "name": "fromDate",
                "value": "",
                "type": "query",
                "description": "From which date to start searching."
              },
              {
                "name": "toDate",
                "value": "",
                "type": "query",
                "description": "At which date to stop searching."
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "Where to start fetching records."
              },
              {
                "name": "max",
                "value": "",
                "type": "query",
                "description": "Maximum number of items in response"
              },
              {
                "name": "order",
                "value": "",
                "type": "query",
                "description": "Ordering direction"
              },
              {
                "name": "q",
                "value": "",
                "type": "query",
                "description": "Can be UUID of the payment, reference, channel UUID, transaction hash, or wallet code."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Retrieves a list of payments to a channel on a specific Merchant ID."
        }
      ]
    }
  ],
  "bundled": true
}