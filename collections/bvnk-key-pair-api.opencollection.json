{
  "opencollection": "1.0.0",
  "info": {
    "name": "Digital Asset Key Pair API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Key Pair",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List key pairs",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.staging.layer1.com/digital/v1/key-pairs",
            "params": [
              {
                "name": "assetPoolId",
                "value": "",
                "type": "query"
              },
              {
                "name": "pageNumber",
                "value": "",
                "type": "query"
              },
              {
                "name": "pageSize",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://auth.sandbox.layer1.com/auth/realms/bvnk/protocol/openid-connect/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Retrieve paginated list of key-pairs belonging to a asset pool"
        },
        {
          "info": {
            "name": "Create key pair",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.staging.layer1.com/digital/v1/key-pairs",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://auth.sandbox.layer1.com/auth/realms/bvnk/protocol/openid-connect/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Creates a new key pair from which different addresses can be created"
        },
        {
          "info": {
            "name": "Get key pair",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.staging.layer1.com/digital/v1/key-pairs/:keyPairId",
            "params": [
              {
                "name": "keyPairId",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://auth.sandbox.layer1.com/auth/realms/bvnk/protocol/openid-connect/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Retrieve a key pair given id"
        }
      ]
    }
  ],
  "bundled": true
}